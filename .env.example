# Management login; choose a password with at least 12 characters.
PRACTICE_ADMIN_USERNAME=admin
PRACTICE_ADMIN_PASSWORD=

# Host-side binding. Keep loopback for SSH forwarding or a local HTTPS proxy.
PRACTICE_BIND=127.0.0.1
PRACTICE_PORT=8765

# Set only when using an HTTPS reverse proxy; no trailing path.
# PRACTICE_PUBLIC_ORIGIN=https://practice.example.com
